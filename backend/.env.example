# ── AutoFlow backend (Node/Express) environment ──
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Server
NODE_ENV=development
PORT=8081

# Upstream Spring automation engine (plugin execution + DB/mail proxies)
ENGINE_URL=http://localhost:8080

# CORS allow-list (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Default workspace root (optional). If unset, select one via POST /api/workspace/select.
# Example (Windows): WORKSPACE_ROOT=D:\AutoFlow\workspace
WORKSPACE_ROOT=

# Request body size limit
BODY_LIMIT=50mb

# ── Authentication (opt-in) ──
# Set AUTH_ENABLED=true and a strong API_AUTH_TOKEN to require
# `Authorization: Bearer <token>` on every /api route except /api/health.
AUTH_ENABLED=false
API_AUTH_TOKEN=

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ── File-operation sandbox ──
# File ops are confined to the active workspace root by default. To allow
# additional absolute roots, list them comma-separated (use with care).
# Example: FILE_OPS_ALLOWED_ROOTS=D:\AutoFlow\shared,D:\AutoFlow\incoming
FILE_OPS_ALLOWED_ROOTS=

# Phase 3 Step 7B.4 - live output indexing. Keep false until the disabled-path
# regression test passes and a controlled workflow run is approved.
EXECUTION_OUTPUT_INDEX_WRITE_ENABLED=false
EXECUTION_OUTPUT_SOURCE_API_ENABLED=false
EXECUTION_OUTPUT_SOURCE_DEFAULT_LIMIT=500
EXECUTION_OUTPUT_SOURCE_MAX_LIMIT=2000

# Phase 3 Step 7B.6A - read-only PostgreSQL workflow version history.
# Keep disabled until repository/router tests pass. This flag exposes no restore
# or write endpoint; it only reads immutable autoflow.workflow_version rows.
WORKFLOW_VERSION_HISTORY_API_ENABLED=false
WORKFLOW_VERSION_HISTORY_DEFAULT_LIMIT=40
WORKFLOW_VERSION_HISTORY_MAX_LIMIT=100

# Phase 3 Step 7B.7 - database closure contract guard.
# The check is read-only. Keep strict=false during the first verification, then
# switch to true after inspect:database-closure returns a verified verdict.
DATABASE_CONTRACT_CHECK_ENABLED=true
DATABASE_CONTRACT_STRICT=false
DB_SCHEMA=autoflow

# The legacy shadow workspace API is no longer needed after primary PostgreSQL
# cutover. Keep both flags false to avoid accidental parallel write paths.
DATABASE_SHADOW_API_ENABLED=false
DATABASE_SHADOW_WRITE_ENABLED=false

# Phase 4B.1 - Products Engine registry -> plugin_endpoint_mapping read-only dry-run.
# The API exposes status and dry-run only. There is no apply/write endpoint in 4B.1.
PLUGIN_ENDPOINT_MAPPING_API_ENABLED=false
PLUGIN_ENDPOINT_MAPPING_ENGINE_VERSION=v11.3
PLUGIN_ENDPOINT_MAPPING_ENGINE_CONTEXT_PATH=/engine
PLUGIN_ENDPOINT_MAPPING_REGISTRY_PATH=/api/v1/actions
# Optional absolute override. Leave empty to derive from ENGINE_URL + context + path.
PLUGIN_ENDPOINT_MAPPING_REGISTRY_URL=
PLUGIN_ENDPOINT_MAPPING_REQUEST_TIMEOUT_MS=15000
PLUGIN_ENDPOINT_MAPPING_PREVIEW_LIMIT=50
PLUGIN_ENDPOINT_MAPPING_WRITE_ENABLED=false
PLUGIN_ENDPOINT_MAPPING_RETIRE_MISSING=true

# Phase 4C.1 - read-only PostgreSQL plugin mapping catalogue.
# Enables frontend shadow comparison only; no mapping write or execution route changes.
PLUGIN_MAPPING_READ_API_ENABLED=false
PLUGIN_MAPPING_READ_DEFAULT_LIMIT=500
PLUGIN_MAPPING_READ_MAX_LIMIT=1000

# ORCH-1 isolated server-side executor. Keep false until certification.
ORCHESTRATOR_ENABLED=false
