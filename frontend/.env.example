# ── AutoFlow frontend (Vite) environment ───────────────────────────────────
# Copy to `.env` and adjust targets. Only VITE_* variables are exposed to the
# browser bundle. Never put connector passwords, tokens, or client secrets here.

# Browser-facing Node API path. Keep relative for same-origin requests.
VITE_NODE_API_BASE=/api
# Vite development proxy target for /api.
VITE_NODE_URL=http://localhost:8081

# Tomcat/Spring target used by the development proxy for these contexts:
#   /engine, /VulnerabilityScanner, /voice_transcription
# Catalogue URLs also use this value, but the runtime rewrites local URLs back
# to the same-origin proxy paths before calling fetch.
VITE_ENGINE_URL=http://localhost:8080
# Optional explicit target alias; wins over VITE_ENGINE_URL in vite.config.ts.
# VITE_ENGINE_PROXY_TARGET=http://localhost:8080

# Engine monitor: browser calls /engine-monitor; Vite forwards to this target.
VITE_ENGINE_MONITOR_API_BASE=/engine-monitor
VITE_ENGINE_MONITOR_URL=http://localhost:8082

# Ollama: browser calls /ollama; Vite forwards to this target.
VITE_OLLAMA_API_BASE=/ollama
VITE_OLLAMA_HOST=http://127.0.0.1:11434
VITE_LLM_MODEL=qwen2.5:14b

# Vite development server.
VITE_DEV_PORT=5173

# Phase 3 Step 7B.5B — PostgreSQL output-source frontend read mode.
# legacy: current snapshot-derived Binding Picker only (default)
# shadow: load PostgreSQL sources and record parity; still render legacy
# postgres: reserved for Step 7B.5C; currently safety-downgraded to shadow
VITE_EXECUTION_OUTPUT_SOURCE_READ_MODE=legacy
VITE_WORKFLOW_VERSION_HISTORY_READ_MODE=legacy

# Phase 4C.1 - PostgreSQL plugin mapping frontend read mode.
# legacy: no mapping API call (default)
# shadow: compare static frontend actions with PostgreSQL mappings; visible catalogue unchanged
# postgres: reserved for a later controlled cutover and currently safety-downgraded to shadow
VITE_PLUGIN_MAPPING_READ_MODE=legacy
